{
  "name": "deepikadubey-portfolio-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling: visual + computed-style regression harnesses and image optimiser. NOT a build step - the site deploys as plain static files.",
  "scripts": {
    "serve": "node tests/serve.mjs",
    "baseline": "node tests/visual.mjs --update",
    "test:visual": "node tests/visual.mjs",
    "computed:save": "node tests/computed.mjs --save",
    "computed": "node tests/computed.mjs",
    "images": "node tools/optimize-images.mjs",
    "images:report": "node tools/optimize-images.mjs --report"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  }
}
