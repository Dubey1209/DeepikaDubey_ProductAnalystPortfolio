# macOS
.DS_Store

# Dev tooling (verification harness only - the site itself has no build step)
node_modules/
package-lock.json

# Visual regression output. Baselines in tests/baseline/ ARE committed;
# these two directories are generated per-run and must not be.
tests/current/
tests/diff/

# Computed-style snapshots. Unlike the screenshot baselines these are not
# committed: they are a before/after reference for the edit in progress,
# regenerated on demand, and would add megabytes of churn to every commit.
tests/computed/

# Editor / OS
*.swp
*~
.idea/
